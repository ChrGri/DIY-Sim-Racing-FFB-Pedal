<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<#
// ---------------------------------------------------------------------------
// ServoTunedParameters.tt
//
// Parses  ESP32/include/isv57_tunedParameters.h  and emits a static C# class
// that exposes the tuned register values as a Dictionary<string, int> keyed
// by address string ("Pr0.00" … "Pr7.49").
//
// Single source of truth: edit the .h file only — this template regenerates
// the C# side automatically whenever it is saved inside Visual Studio or when
// the project is built with <TransformOnBuild>true</TransformOnBuild>.
// ---------------------------------------------------------------------------

// Resolve path relative to this .tt file:
//   SimHubPlugin/Generated/ServoTunedParameters.tt
//   ? ../../ESP32/include/isv57_tunedParameters.h
string hFile = this.Host.ResolvePath(
    Path.Combine("..", "..", "ESP32", "include", "isv57_tunedParameters.h"));

if (!File.Exists(hFile))
{
    Error($"Cannot find tuned-parameters file: {hFile}");
    return "";
}

// Both files use one register per line:
//    { 0,  0,    500 },  // Pr0.00: Model-following control (MFC) bandwidth
//    { 4,  8, 0x0303 },  // Pr4.08: Input selection SI9
//    { 1,  6,   800 },  // 2nd velocity loop gain             (smooth file: no "PrX.YY:")
// Groups:  1=class  2=number  3=value  4=comment (optional)
var lineRx = new Regex(
    @"^\s*\{\s*(\d+)\s*,\s*(\d+)\s*,\s*(-?(?:0[xX][0-9a-fA-F]+|\d+))\s*\}\s*,?\s*(?://\s*(.*))?$",
    RegexOptions.Compiled);
var commentAddrRx = new Regex(@"^Pr(\d+)\.(\d+):\s*(.*)$", RegexOptions.Compiled);

List<(string addr, int value, string desc)> ParseRows(string path)
{
    var rows = new List<(string addr, int value, string desc)>();
    foreach (var line in File.ReadLines(path))
    {
        var m = lineRx.Match(line);
        if (!m.Success) continue;
        string token = m.Groups[3].Value;
        int value = (token.StartsWith("0x") || token.StartsWith("0X"))
            ? (int)Convert.ToUInt32(token, 16) : int.Parse(token);
        string addr = $"Pr{int.Parse(m.Groups[1].Value)}.{int.Parse(m.Groups[2].Value):D2}";
        string desc = m.Groups[4].Value.Trim();
        var c = commentAddrRx.Match(desc);
        if (c.Success)
        {
            // the comment repeats the address: it must match the data
            string commentAddr = $"Pr{int.Parse(c.Groups[1].Value)}.{int.Parse(c.Groups[2].Value):D2}";
            if (commentAddr != addr)
                Error($"{Path.GetFileName(path)}: row {addr} has the comment of {commentAddr}");
            desc = c.Groups[3].Value.Trim();
        }
        // trim trailing "..." artefacts from truncated comments in the .h file
        int dotIdx = desc.IndexOf("...");
        if (dotIdx > 0) desc = desc.Substring(0, dotIdx).TrimEnd();
        rows.Add((addr, value, desc));
    }
    return rows;
}

var entries = ParseRows(hFile);

// "Smooth" set: overrides of single registers (gain switching), same row format.
string hSmoothFile = this.Host.ResolvePath(
    Path.Combine("..", "..", "ESP32", "include", "isv57_tunedParameters_smooth.h"));
var smoothOverrides = new List<(string addr, int value, string desc)>();
if (File.Exists(hSmoothFile))
{
    smoothOverrides = ParseRows(hSmoothFile);
    foreach (var o in smoothOverrides)
        if (!entries.Exists(e => e.addr == o.addr))
            Error($"Smooth override for unknown register {o.addr} in {hSmoothFile}");
}
else
{
    Warning($"Cannot find smooth parameter file: {hSmoothFile}");
}

if (entries.Count == 0)
{
    Error("No register entries found — check the regex against the .h file format.");
    return "";
}
#>
// <auto-generated>
//   Generated by ServoTunedParameters.tt
//   Source: ESP32/include/isv57_tunedParameters.h (silent)
//           ESP32/include/isv57_tunedParameters_smooth.h (smooth overrides)
//
//   DO NOT EDIT MANUALLY.
//   To update: edit isv57_tunedParameters.h, then in Visual Studio either
//   • save this .tt file, or
//   • Build ? Transform All T4 Templates.
// </auto-generated>

using System.Collections.Generic;

namespace DiyFfbPedal.UIFunction
{
    /// <summary>
    /// Auto-generated class that mirrors <c>tuned_parameters[]</c> from
    /// <c>ESP32/include/isv57_tunedParameters.h</c>.
    /// Keyed by Pr-address string (e.g. <c>"Pr1.03"</c>).
    /// </summary>
    internal static class Isv57TunedParameters
    {
        /// <summary>
        /// Number of iSV57 registers in the tuned-parameters file.
        /// Matches <c>ISV57_NMB_OF_REGISTERS</c> in the firmware header.
        /// </summary>
        public const int Count = <#= entries.Count #>;

        /// <summary>
        /// Recommended value for each iSV57 register, keyed by address string
        /// (e.g. <c>"Pr0.00"</c> … <c>"Pr7.49"</c>).
        /// </summary>
        public static readonly Dictionary<string, int> Values =
            new Dictionary<string, int>(<#= entries.Count #>)
        {
<#
    for (int i = 0; i < entries.Count; i++)
    {
        var e = entries[i];
        string comma = (i < entries.Count - 1) ? "," : " ";
        string shortDesc = e.desc.Length > 55 ? e.desc.Substring(0, 52) + "…" : e.desc;
#>
            { "<#= e.addr #>", <#= e.value #> }<#= comma #>  // <#= shortDesc #>
<#
    }
#>
        };

        /// <summary>
        /// Registers of the "smooth" set (gain switching) that differ from <see cref="Values"/>,
        /// from <c>ESP32/include/isv57_tunedParameters_smooth.h</c>.
        /// </summary>
        public static readonly Dictionary<string, int> SmoothOverrides =
            new Dictionary<string, int>(<#= smoothOverrides.Count #>)
        {
<#
    for (int i = 0; i < smoothOverrides.Count; i++)
    {
        var e = smoothOverrides[i];
        string comma = (i < smoothOverrides.Count - 1) ? "," : " ";
        string shortDesc = e.desc.Length > 55 ? e.desc.Substring(0, 52) + "..." : e.desc;
#>
            { "<#= e.addr #>", <#= e.value #> }<#= comma #>  // <#= shortDesc #>
<#
    }
#>
        };

        /// <summary>
        /// Value of a register in the "silent" (default) or "smooth" set.
        /// </summary>
        public static bool TryGetValue(string address, bool smooth, out int value)
        {
            if (smooth && SmoothOverrides.TryGetValue(address, out value))
                return true;
            return Values.TryGetValue(address, out value);
        }
    }
}
