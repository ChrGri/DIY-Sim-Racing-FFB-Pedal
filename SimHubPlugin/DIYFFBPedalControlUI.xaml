                                                        <Line X1="250" Y1="0" X2="250" Y2="3" Stroke="#55FFFFFF"/>
                                                        <Line X1="374" Y1="0" X2="374" Y2="3" Stroke="#55FFFFFF"/>
                                                        <Line X1="499" Y1="0" X2="499" Y2="3" Stroke="#55FFFFFF"/>
                                                        <Line X1="623" Y1="0" X2="623" Y2="3" Stroke="#55FFFFFF"/>

                                                        <!-- Tick Labels -->
                                                        <TextBlock Text="-5s" Foreground="#77FFFFFF" FontSize="7" FontFamily="Consolas" Canvas.Left="2" Canvas.Top="2"/>
                                                        <TextBlock Text="-4s" Foreground="#77FFFFFF" FontSize="7.5" FontFamily="Consolas" Canvas.Left="115" Canvas.Top="2"/>
                                                        <TextBlock Text="-3s" Foreground="#77FFFFFF" FontSize="7.5" FontFamily="Consolas" Canvas.Left="240" Canvas.Top="2"/>
                                                        <TextBlock Text="-2s" Foreground="#77FFFFFF" FontSize="7.5" FontFamily="Consolas" Canvas.Left="365" Canvas.Top="2"/>
                                                        <TextBlock Text="-1s" Foreground="#77FFFFFF" FontSize="7.5" FontFamily="Consolas" Canvas.Left="490" Canvas.Top="2"/>
