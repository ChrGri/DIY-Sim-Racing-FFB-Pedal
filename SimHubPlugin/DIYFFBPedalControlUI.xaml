                                                        <Polyline x:Name="poly_rssi_brake" Stroke="#00E676" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                                        <Polyline x:Name="poly_rssi_throttle" Stroke="#2979FF" StrokeThickness="1.5" StrokeLineJoin="Round"/>
