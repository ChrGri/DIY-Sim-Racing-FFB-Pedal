                                                        <Line X1="0" Y1="53" X2="624" Y2="53" Stroke="#18FFFFFF" StrokeDashArray="2 2"/>
                                                        <TextBlock Text="-85dBm" Foreground="#44FFFFFF" FontSize="7" FontFamily="Consolas" Canvas.Left="4" Canvas.Top="47"/>

                                                        <!-- Vertical Time Grid Lines -->
                                                        <Line X1="125" Y1="0" X2="125" Y2="70" Stroke="#0DFFFFFF" StrokeDashArray="2 2"/>
                                                        <Line X1="250" Y1="0" X2="250" Y2="70" Stroke="#0DFFFFFF" StrokeDashArray="2 2"/>
                                                        <Line X1="374" Y1="0" X2="374" Y2="70" Stroke="#0DFFFFFF" StrokeDashArray="2 2"/>
                                                        <Line X1="499" Y1="0" X2="499" Y2="70" Stroke="#0DFFFFFF" StrokeDashArray="2 2"/>

                                                        <!-- Live RSSI Traces: Red=Clutch, Green=Brake, Blue=Throttle -->
