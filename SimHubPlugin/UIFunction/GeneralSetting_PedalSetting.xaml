<UserControl x:Class="DiyFfbPedal.UIFunction.GeneralSetting_PedalSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:localUI="clr-namespace:DiyFfbPedal.UIElement"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" mc:Ignorable="d" 
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             d:DesignHeight="200" d:DesignWidth="648">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource Card}" Margin="0" Height="200" Padding="0,0,0,8">
            <StackPanel HorizontalAlignment="Left" Height="200" VerticalAlignment="Center" Width="648">
                <StackPanel Height="20" Width="648" Orientation="Horizontal" Margin="0,3,0,0">
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextGeneralSetting, 'General Settings'}" Height="18" Width="200" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial Black" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                </StackPanel>
                <StackPanel Height="36" Width="648" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingLinearPitch, 'Linear Module Pitch:'}" Height="20" Width="105" FontSize="10" Padding="0,0,0,0" VerticalContentAlignment="Center" Margin="15,0,0,0" FontFamily="Arial"/>
                    <ComboBox x:Name="ComboboxPitchSelection" SelectionChanged="ComboboxPitchSelection_SelectionChanged" Width="50" Height="20" FontSize="10" SelectedIndex="5" Margin="4,0,0,0" HorizontalAlignment="Left" MinHeight="20" ToolTip="Spindle pitch of the linear module in mm per motor revolution (e.g. 5 or 10).&#x0a;Must match your hardware: a wrong value scales travel, speed and pedal geometry incorrectly." BorderThickness="0,0,0,0">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                    </ComboBox>
                    <StackPanel Height="20" Width="350" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <styles:SHToggleButton x:Name="CheckBox_StepLossRecov" Content="" Checked="CheckBox_StepLossRecov_Checked" Unchecked="CheckBox_StepLossRecov_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="{Binding ToolTip, ElementName=Label_StepLossRecov}" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,0" />
                        <Label x:Name="Label_StepLossRecov" ToolTip="Keeps the pedal position in sync with the servo encoder.&#x0a;While the pedal rests in the first 10 % of travel, lost steps are detected and corrected.&#x0a;Keep enabled; disable only for debugging." Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingStepLossRecor, 'Enable step loss recov.'}" Height="20" Width="130" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="4,0,0,0"/>
                        <styles:SHToggleButton x:Name="CheckBox_CrashDetection" Content="" Checked="CheckBox_CrashDetection_Checked" Unchecked="CheckBox_CrashDetection_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="{Binding ToolTip, ElementName=Label_CrashDetection}" RenderTransformOrigin="0.5,0.5" Margin="10,0,0,0" />
                        <Label x:Name="Label_CrashDetection" ToolTip="Protects the servo when the sled is pressed against a mechanical hard stop.&#x0a;If the servo stalls there with high current (150 % or more), the position is backed off slightly to relieve the strain.&#x0a;Keep enabled; disable only for debugging." Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingCrashDetect, 'Enable crash detect.'}" Height="20" Width="130" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Height="40" Width="648" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,3,0,0">
                    <localUI:SliderWithLabel x:Name="Slider_LC_rate" Width="250" SliderLength="240" SliderName="{SLoc DIYFFBPedalPlugin_TextGeneralSettingLoadcellRate, 'Loadcell Rate'}" MaxValue="500" Height="40" Unit="kg" TickFrequency="10" SliderValue="300" SliderValueChanged="Slider_LC_rate_SliderValueChanged" Margin="15,0,0,0" ToolTip="Rated capacity of your load cell in kg (printed on the load cell, e.g. 150 kg).&#x0a;Must match the hardware: a wrong value scales every measured force, so the whole force curve feels too light or too heavy.&#x0a;Takes effect after you save the config as default and restart the pedal."/>
                    <localUI:SliderWithLabel x:Name="Slider_maxgame_output" SliderName="{SLoc DIYFFBPedalPlugin_TextGeneralSettingMaxGameOut, 'Max Game Output'}" SliderLength="240" SliderValue="100" Width="250" Height="40" Margin="10,0,0,0" Unit="%" SliderValueChanged="Slider_maxgame_output_SliderValueChanged" ToolTip="Joystick value the game receives at full pedal input.&#x0a;100 %: full range. Lower: the game never sees more than this value, e.g. to limit maximum brake pressure in the game.&#x0a;Does not change the pedal feel."/>
                </StackPanel>
                <StackPanel Height="36" Width="648" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                    <StackPanel Height="20" Width="175" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" ToolTip="Source of the joystick value sent to the game.&#x0a;On: pedal position (travel), like a throttle or clutch with a position sensor.&#x0a;Off: measured pedal force, like a load cell brake.">
                        <styles:SHToggleButton x:Name="CheckBox_JoystickOutput" Content="" Checked="CheckBox_JoystickOutput_Checked" Unchecked="CheckBox_JoystickOutput_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,0" />
                        <Label Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingJoystickOutputFromTravel, 'Joystick output from travel'}" Height="20" Width="135" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Height="20" Width="150" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="Inverts the sign of the load cell reading.&#x0a;Enable if the measured force decreases (goes negative) when you press the pedal, e.g. with a load cell mounted the other way round.&#x0a;Takes effect after you save the config as default and restart the pedal.">
                        <styles:SHToggleButton x:Name="CheckBox_InvertLoadcellReading" Content="" Checked="CheckBox_InvertLoadcellReading_Checked" Unchecked="CheckBox_InvertLoadcellReading_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" Margin="0,0,0,0" />
                        <Label x:Name="Label_reverse_LC" Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingReverseLCReading, 'Reverse LC reading'}" Height="20" Width="110" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Height="20" Width="180" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="Reverses the direction the servo turns.&#x0a;Enable if the sled moves the wrong way (e.g. homing runs away from the endstop), typically with a mirrored mechanical setup.&#x0a;Takes effect after you save the config as default and restart the pedal.">
                        <styles:SHToggleButton x:Name="CheckBox_InvertMotorDir" Content="" Checked="CheckBox_InvertMotorDir_Checked" Unchecked="CheckBox_InvertMotorDir_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" Margin="0,0,0,0" />
                        <Label x:Name="Label_reverse_servo" Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingReverseServoDirection, 'Reverse Servo Direction'}" Height="20" Width="140" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Height="30" Width="648" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                    <StackPanel Height="20" Width="175" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" ToolTip="When enabled, the pedal will stay in standby on power-up and only initialize/home when SimHub connects or triggers wakeup">
                        <styles:SHToggleButton x:Name="CheckBox_WakeOnPluginOnly" Content="" Checked="CheckBox_WakeOnPluginOnly_Checked" Unchecked="CheckBox_WakeOnPluginOnly_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,0" />
                        <Label Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingWakeOnPluginOnly, 'Wakeup only by plugin trigger'}" Height="20" Width="190" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Height="20" Width="300" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="The brake resistor burns off the energy the servo feeds back when the pedal is pushed back fast, protecting the power supply from overvoltage.&#x0a;Keep enabled. When disabled, the brake resistor is never switched on (debug/bench use only - servo braking energy will not be dissipated).">
                        <styles:SHToggleButton x:Name="CheckBox_EnableBrakeResistor" Content="" Checked="CheckBox_EnableBrakeResistor_Checked" Unchecked="CheckBox_EnableBrakeResistor_Unchecked" IsChecked="True" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,0" />
                        <Label Content="{SLoc DIYFFBPedalPlugin_TextGeneralSettingEnableBrakeResistor, 'Enable brake resistor'}" Height="20" Width="110" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                        <TextBox x:Name="TextBox_BrakeResistorResistance" Width="40" Height="18" FontSize="10" FontFamily="Arial" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="2,0,2,0" Margin="6,0,0,0" Text="10" KeyDown="TextBox_BrakeResistorResistance_KeyDown" LostFocus="TextBox_BrakeResistorResistance_LostFocus" ToolTip="Resistance of the fitted brake resistor in Ohm (1 - 255).&#x0a;Sets the PWM duty that dissipates the regen power and the resistor's thermal model. Confirm with Enter."/>
                        <Label Content="&#x03A9;" Height="20" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" Margin="3,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>