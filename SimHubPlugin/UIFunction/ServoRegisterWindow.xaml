<Window x:Class="DiyFfbPedal.UIFunction.ServoRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:localFunction="clr-namespace:DiyFfbPedal.UIFunction"
        mc:Ignorable="d" 
        Title="Servo Register Editor - iSV57" Height="700" Width="900" MinHeight="500" MinWidth="700"
        Background="#202020" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Column header style -->
            <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#FF303030"/>
                <Setter Property="Foreground" Value="#FFD0D0D0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="BorderBrush" Value="#FF444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Row style: alternate shading -->
            <Style x:Key="RowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="#FF262626"/>
                <Setter Property="Height" Value="24"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FF2E2E2E"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF3A3A5A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FF2D5A8E"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Cell style -->
            <Style x:Key="CellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#FFDADADA"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Toolbar Button Style -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF383838"/>
                <Setter Property="Foreground" Value="#FFECECEC"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF4C4C4C"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF777777"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF222222"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Toolbar Button Style -->
            <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="#FF1E5F99"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF3A85C8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Search & Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid (Takes rest of space) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── Row 0: Top Toolbar ────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#FF2B2B2B" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" BorderBrush="#FF444444" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Label Content="Target Pedal:" Foreground="#FFCCCCCC" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Padding="0,0,6,0"/>
                    <ComboBox x:Name="CboPedalSelect" Width="110" Height="24" SelectionChanged="CboPedalSelect_SelectionChanged" Background="#FF333333" Foreground="White" BorderBrush="#FF555555">
                        <ComboBoxItem Content="Clutch (0)" Tag="0"/>
                        <ComboBoxItem Content="Brake (1)" Tag="1"/>
                        <ComboBoxItem Content="Throttle (2)" Tag="2"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Load from servo"
                            x:Name="Btn_LoadFromServo"
                            Style="{StaticResource PrimaryToolbarButtonStyle}"
                            Click="Btn_LoadFromServo_Click"
                            ToolTip="Sequentially reads all registers from the servo"/>
                    <Button Content="Reset to recommended"
                            x:Name="Btn_ResetToRecommended"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Btn_ResetToRecommended_Click"
                            ToolTip="Writes the silent or the smooth (gain switching) parameter set to the servo and stores it in its NVM"/>
                    <Button Content="Reset to factory"
                            x:Name="Btn_ResetToFactory"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Btn_ResetToFactory_Click"
                            ToolTip="Resets all servo parameters to factory values (power-cycle the servo afterwards)"/>
                    <Button Content="Flash to servo"
                            x:Name="Btn_FlashToServo"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Btn_FlashToServo_Click"
                            ToolTip="Saves the current parameters permanently in the servo (power-cycle required)"/>
                    <Button Content="Export"
                            x:Name="Btn_ExportServoParameters"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Btn_ExportServoParameters_Click"
                            ToolTip="Saves the live values to a CSV file"/>
                    <Button Content="Import"
                            x:Name="Btn_ImportServoParameters"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Btn_ImportServoParameters_Click"
                            Margin="0"
                            ToolTip="Loads a CSV file, writes its values to the servo and stores them in NVM"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── Row 1: Filter bar ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#FF282828" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" BorderBrush="#FF3C3C3C" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Label Content="Filter / Search:" Foreground="#FFAAAAAA" VerticalAlignment="Center" FontSize="11" Padding="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Width="200" Height="22" VerticalContentAlignment="Center" Background="#FF1E1E1E" Foreground="White" BorderBrush="#FF555555" Padding="4,1" TextChanged="TxtSearch_TextChanged" ToolTip="Search by register address (e.g. Pr1.01) or parameter name"/>
                    <Button Content="Clear" Width="50" Height="22" Margin="5,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="BtnClearSearch_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Tip: Double click 'Live (Servo)' cell to edit and push value immediately." Foreground="#FF888888" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── Row 2: DataGrid ───────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#FF242424" CornerRadius="4" BorderBrush="#FF444444" BorderThickness="1">
            <DataGrid x:Name="ServoRegisterGrid"
                      ItemsSource="{Binding ServoRegisters, RelativeSource={RelativeSource AncestorType=localFunction:ServoRegisterWindow}}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      AlternatingRowBackground="#FF2E2E2E"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FF3E3E3E"
                      BorderThickness="0"
                      Background="Transparent"
                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                      RowStyle="{StaticResource RowStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      CellEditEnding="ServoRegisterGrid_CellEditEnding">

                <DataGrid.Columns>
                    <!-- Address -->
                    <DataGridTemplateColumn Header="Register"
                                            Width="90"
                                            IsReadOnly="True"
                                            SortMemberPath="Index">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Address}"
                                           ToolTip="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="#FF9ECFFF"
                                           FontWeight="SemiBold"
                                           Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Full name (read-only) -->
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        IsReadOnly="True"/>

                    <!-- Live value – editable; sends to servo on commit -->
                    <DataGridTemplateColumn Header="Live (Servo)"
                                            Width="120"
                                            SortMemberPath="LiveValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LiveValueDisplay}"
                                           Foreground="{Binding LiveValueColor}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LiveValue, UpdateSourceTrigger=LostFocus}"
                                         BorderThickness="1"
                                         BorderBrush="#FF1E5F99"
                                         Background="#FF333333"
                                         Foreground="White"
                                         Padding="2,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Recommended value (read-only) -->
                    <DataGridTemplateColumn x:Name="ColRecommended"
                                            Header="Recommended (silent)"
                                            Width="160"
                                            IsReadOnly="True"
                                            SortMemberPath="RecommendedValue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecommendedValue}"
                                           Foreground="#FF888888"
                                           VerticalAlignment="Center"
                                           Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ─── Row 3: Bottom Status Bar ──────────────────────────────────── -->
        <Border Grid.Row="3" Background="#FF1E1E1E" CornerRadius="4" Padding="10,6" Margin="0,8,0,0" BorderBrush="#FF383838" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#FFCCCCCC" FontSize="11" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBarMain" Width="180" Height="14" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummary" Text="Total: 0 registers" Foreground="#FF888888" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
