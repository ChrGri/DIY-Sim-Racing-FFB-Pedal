<UserControl x:Class="DiyFfbPedal.UIFunction.LivePlot_ExtendedState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="764"
             HorizontalAlignment="Left" Width="764" Height="850" Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ModernPillButton" TargetType="Button">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="#D0D0D0"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#383838"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Width="764" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0">
        
        <!-- Header & Control Bar (Width 764 matching tab bar) -->
        <Border Background="#202020" CornerRadius="5" BorderBrush="#333333" BorderThickness="1" Padding="10,6" Width="764">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Title and Stream Status Badge -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE TELEMETRY PLOTTER" FontFamily="Arial Black" FontSize="13" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                        <TextBlock Text="— Right-click plot to select signals" FontSize="11" Foreground="#888888" Margin="10,2,0,0" VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>
                    
                    <!-- Stream Status Pill (Always visible in top right) -->
                    <Border HorizontalAlignment="Right" Background="#282828" BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ellipse_stream_indicator" Width="8" Height="8" Fill="#757575" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="tb_stream_status" Text="○ Idle" FontSize="11" Foreground="#9E9E9E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Controls Toolbar -->
                <Grid Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pedal:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,2,0" FontWeight="SemiBold"/>
                        <Button x:Name="btn_pedal_clutch" Content="Clutch" Tag="0" Click="BtnPedal_Click" Width="44" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,2,0"/>
                        <Button x:Name="btn_pedal_brake" Content="Brake" Tag="1" Click="BtnPedal_Click" Width="44" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,2,0"/>
                        <Button x:Name="btn_pedal_throttle" Content="Throttle" Tag="2" Click="BtnPedal_Click" Width="48" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,5,0"/>

                        <Border Width="1" Height="14" Background="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>

                        <Button x:Name="btn_live_pause" Content="⏸ Pause" Click="BtnLivePause_Click" Width="52" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,2,0"/>
                        <Button x:Name="btn_clear" Content="🗑 Clear" Click="BtnClear_Click" Width="44" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,5,0"/>

                        <Border Width="1" Height="14" Background="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Win:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <ComboBox x:Name="cb_time_window" Width="44" Height="22" SelectionChanged="CbTimeWindow_SelectionChanged" Margin="0,0,5,0" Background="#2A2A2A" Foreground="White" FontSize="10"/>

                        <CheckBox x:Name="chk_auto_scale" Content="Auto" ToolTip="Auto-Scale Y Amplitude to Signal Range" IsChecked="True" Checked="ChkAutoScale_Changed" Unchecked="ChkAutoScale_Changed" FontSize="10" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>

                        <Border Width="1" Height="14" Background="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>

                        <!-- Zoom Controls: Horizontal (↔), Vertical (↕), Regional Box (⊞), Reset (⟲) -->
                        <TextBlock Text="Zoom:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,2,0" FontWeight="SemiBold"/>
                        <Button x:Name="btn_zoom_x_in" Content="↔+" ToolTip="Horizontal Zoom In (or Mouse Wheel)" Click="BtnZoomXIn_Click" Width="24" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,1,0"/>
                        <Button x:Name="btn_zoom_x_out" Content="↔−" ToolTip="Horizontal Zoom Out (or Mouse Wheel)" Click="BtnZoomXOut_Click" Width="24" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,3,0"/>
                        <Button x:Name="btn_zoom_y_in" Content="↕+" ToolTip="Vertical Zoom In (or Shift + Mouse Wheel)" Click="BtnZoomYIn_Click" Width="24" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,1,0"/>
                        <Button x:Name="btn_zoom_y_out" Content="↕−" ToolTip="Vertical Zoom Out (or Shift + Mouse Wheel)" Click="BtnZoomYOut_Click" Width="24" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,3,0"/>
                        <Button x:Name="btn_zoom_box" Content="⊞ Box" ToolTip="Regional Box Zoom: Shift + Mouse Drag on plot (or toggle button)" Click="BtnZoomBox_Click" Width="38" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,3,0"/>
                        <Button x:Name="btn_reset_zoom" Content="⟲ Fit" ToolTip="Reset Zoom &amp; Pan to Fit All (or Double-Click plot)" Click="BtnResetZoom_Click" Width="42" Height="22" Style="{StaticResource ModernPillButton}"/>
                    </StackPanel>

                    <!-- Signals Menu Button (Always right-aligned) -->
                    <Button x:Name="btn_signals_menu" Content="Signals ▾" Click="BtnSignalsMenu_Click" HorizontalAlignment="Right" Width="64" Height="22" Style="{StaticResource ModernPillButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Enlarged Plot Canvas Area (Width 764 matching tab bar, Height 580px) -->
        <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" Width="764" Height="580" ClipToBounds="True">
            <Grid x:Name="grid_plot_host">
                <!-- Background Gridlines & Axis Labels -->
                <Canvas x:Name="canvas_grid" Width="762" Height="578" IsHitTestVisible="False"/>
                
                <!-- Main Polyline Trace Canvas with Right-Click Context Menu & Hover Data Tip -->
                <Canvas x:Name="canvas_plot" Width="762" Height="578" Background="Transparent" Cursor="Cross"
                        SizeChanged="Canvas_plot_SizeChanged"
                        MouseDown="Canvas_plot_MouseDown"
                        MouseMove="Canvas_plot_MouseMove"
                        MouseUp="Canvas_plot_MouseUp"
                        MouseLeave="Canvas_plot_MouseLeave"
                        MouseWheel="Canvas_plot_MouseWheel">
                    <Canvas.ContextMenu>
                        <ContextMenu x:Name="plot_context_menu" Opened="Plot_context_menu_Opened">
                            <!-- Populated in code-behind with Servo, ESP & Admittance submenus + Zoom items -->
                        </ContextMenu>
                    </Canvas.ContextMenu>
                </Canvas>

                <!-- Rubber-Band Regional Zoom Selection Box -->
                <Rectangle x:Name="rect_zoom_selection" Stroke="#00E5FF" StrokeThickness="1.5" StrokeDashArray="3,3" Fill="#3300E5FF" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!-- Vertical Crosshair Cursor Line -->
                <Line x:Name="line_crosshair" X1="0" Y1="0" X2="0" Y2="578" Stroke="#77FFFFFF" StrokeDashArray="3,3" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Hover Data Tip Floating Card -->
                <Border x:Name="card_datatip" Background="#EE161616" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4" Padding="8,6" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="tb_datatip_time" Text="Time: -0.00s" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,2"/>
                        <TextBlock x:Name="tb_datatip_servo_cycle" Text="Servo Cycle: 0" FontSize="10" Foreground="#B0BEC5" Margin="0,0,0,1"/>
                        <TextBlock x:Name="tb_datatip_esp_cycle" Text="ESP Cycle: 0" FontSize="10" Foreground="#CFD8DC" Margin="0,0,0,3"/>
                        <Border x:Name="border_datatip_sep" Height="1" Background="#333333" Margin="0,0,0,3" Visibility="Collapsed"/>
                        <StackPanel x:Name="sp_datatip_items" Orientation="Vertical"/>
                    </StackPanel>
                </Border>

                <!-- No signals placeholder text -->
                <TextBlock x:Name="tb_no_signals_hint" Text="Right-click canvas to select signals to plot" Foreground="#444444" FontSize="14" FontFamily="Segoe UI, Arial" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Compact Active Signals & Legend Card (Width 764, Height 100px) -->
        <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" Width="764" Height="100" Padding="8,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE SIGNALS" FontFamily="Arial Black" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock x:Name="tb_active_count" Text="(0 active)" FontSize="10" Foreground="#666666" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear All" Click="BtnClearAllSignals_Click" FontSize="9" Style="{StaticResource ModernPillButton}" Padding="5,1" Height="18" Margin="0,0,3,0"/>
                        <Button Content="Reset Defaults" Click="BtnResetDefaultSignals_Click" FontSize="9" Style="{StaticResource ModernPillButton}" Padding="5,1" Height="18"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="panel_legends" Orientation="Horizontal" Margin="0,2,0,0"/>
                </ScrollViewer>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>