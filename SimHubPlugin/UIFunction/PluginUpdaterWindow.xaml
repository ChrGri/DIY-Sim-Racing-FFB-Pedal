<Window x:Class="DiyFfbPedal.UIFunction.PluginUpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
        Title="Plugin Rollback" Height="250" Width="400" Background="#252525" WindowStyle="ToolWindow" ResizeMode="NoResize" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Background="#7F4E4E4E" CornerRadius="5" BorderThickness="0,2,0,0">
            <StackPanel Margin="10">
                <Label Content="Plugin Rollback" FontSize="15" FontFamily="Arial Black" Foreground="White" HorizontalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
                    <Label Content="Available Versions:" Width="120" Foreground="White" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboVersions" Width="200" Height="25" DisplayMemberPath="Key" SelectedValuePath="Value"/>
                </StackPanel>

                <styles:SHButtonPrimary x:Name="BtnUpdate" Content="Update Plugin" Height="30" Margin="0,10,0,0" Click="BtnUpdate_Click"/>

                <TextBox x:Name="TxtLog" Height="80" Margin="0,10,0,0" IsReadOnly="True" Background="#1E1E1E" Foreground="LightGreen" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
