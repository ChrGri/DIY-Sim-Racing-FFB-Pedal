<UserControl x:Class="DiyFfbPedal.UIFunction.SettingSection_Pedal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:localUI="clr-namespace:DiyFfbPedal.UIElement"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" mc:Ignorable="d" 
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             d:DesignHeight="135" d:DesignWidth="192">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
            <StackPanel HorizontalAlignment="Center" Height="135" VerticalAlignment="Top" Width="192">
                <Label Content="{SLoc DIYFFBPedalPlugin_LabelPedalSetting, 'Pedal Setting'}" Height="20" Width="180" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial Black" Foreground="White" HorizontalAlignment="Left" FontSize="10" Margin="2,0,0,0"/>
                                <StackPanel Width="186" Height="16" Orientation="Horizontal" Margin="2,1,0,0">
                    <Grid Width="186" Height="16">
                        <Label x:Name="Label_Pedal_interval_trigger" Width="186" Foreground="White" RenderTransformOrigin="0.5,0.5" Canvas.Top="3" FontSize="8" FontFamily="Arial" Canvas.Left="5" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Effect update rate:" Height="16" Padding="0,0,0,0" Cursor="Hand" ToolTip="Click to type update rate (15, 20, 30, 60 Hz)" MouseLeftButtonDown="Label_Pedal_interval_trigger_MouseLeftButtonDown" Background="Transparent"/>
                        <TextBox x:Name="TextBox_edit_Pedal_interval" Width="50" Height="16" FontSize="8" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Background="#FF3F3F46" Foreground="White" BorderBrush="{DynamicResource AccentBaseColorBrush}" KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus" Padding="1,0,1,0"/>
                    </Grid>
                </StackPanel>
                <Slider x:Name="Slider_Pedal_interval_trigger" Style="{DynamicResource SliderStyle_single_H}" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Width="186" Height="10" Minimum="15" Maximum="60" TickPlacement="BottomRight" Ticks="15,20,30,60" IsSnapToTickEnabled="True" Value="30" ValueChanged="Slider_Pedal_interval_trigger_ValueChanged" ToolTip="Requires a SimHub license; the free version is limited to 10 FPS." Margin="3,2,0,0"/>
                <StackPanel x:Name="text_debug_flag" Height="20" Width="180" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0">
                    <Label Content="{SLoc DIYFFBPedalPlugin_LabelDebugFlag0, 'Debug flags:'}" Height="20" Width="65" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="5,0,0,0"/>
                    <TextBox x:Name="textBox_debug_Flag_0" Width="40" Height="20" PreviewTextInput="NumericTextBox_PreviewTextInput" TextChanged="textBox_debug_Flag_0_TextChanged" Margin="2,0,0,0" HorizontalAlignment="Left" MinHeight="20" FontSize="8" ToolTip="Debug flags for the firmware (see the docs)" BorderThickness="0,0,0,0"/>
                </StackPanel>
                <StackPanel Height="20" Width="192" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,2,0,0">
                    <styles:SHToggleButton x:Name="checkbox_auto_connect" Content="" Checked="checkbox_auto_connect_Checked" Unchecked="checkbox_auto_connect_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="Scans the COM ports every 5 s and reconnects the last pedal until you press Disconnect" RenderTransformOrigin="0.5,0.5" Margin="-10,0,0,0" />
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextAutomaticPedalConnect, 'Auto-connect pedal'}" Height="20" Width="130" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Height="20" Width="192" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,2,0,0">
                    <styles:SHToggleButton x:Name="CheckBox_Pedal_ESPNow_SyncFlag" Content="" Checked="CheckBox_Pedal_ESPNow_SyncFlag_Checked" Unchecked="CheckBox_Pedal_ESPNow_SyncFlag_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" RenderTransformOrigin="0.5,0.5" Margin="-10,0,0,0" />
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextWirelessCommunication, 'Wireless Communication'}" Height="20" Width="130" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Height="20" Width="192" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,2,0,0">
                    <styles:SHToggleButton x:Name="dump_pedal_response_to_file" Content="" Checked="dump_pedal_response_to_file_Checked" Unchecked="dump_pedal_response_to_file_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial" ToolTip="Writes the pedal's real-time state to a file. Turn off when not in use." RenderTransformOrigin="0.5,0.5" Margin="-10,0,0,0" />
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextLogPedalStates, 'Record pedal trace'}" Height="20" Width="90" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="4,0,0,0"/>
                    <TextBlock 
                       Height="11"
                       VerticalAlignment="Center"
                       FontFamily="Arial"
                       FontSize="10"
                       Margin="0,0,0,0"
                       Width="30" RenderTransformOrigin="0.451,1.125"
                        >
                        <Hyperlink NavigateUri="https://github.com/ChrGri/DIY-Sim-Racing-FFB-Pedal/blob/develop/Validation/README_visualizePedalLogs.md"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            (docs)
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>







            </StackPanel>
    </Grid>
</UserControl>
