<UserControl x:Class="DiyFfbPedal.UIFunction.CurveTab_RudderJoystickMapping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" mc:Ignorable="d" 
             d:DesignHeight="272" d:DesignWidth="540">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border HorizontalAlignment="Left" Height="272" VerticalAlignment="Top" Width="540" Background="#7F4E4E4E" CornerRadius="8" Padding="0,0,0,4">
            <Grid Width="540" Height="268">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="264"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: YAW JOYSTICK MAPPING (50% - 100% Symmetrical) -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Width="264" Margin="0,0,0,0">
                    <StackPanel Height="20" Orientation="Horizontal" HorizontalAlignment="Left" Margin="22,2,0,2">
                        <Label Content="YAW MAPPING (50% - 100%)" Foreground="White" FontFamily="Arial Black" FontSize="10" Padding="0" VerticalAlignment="Center"/>
                        <Border Background="#3300FFCC" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SYMMETRICAL" Foreground="#00FFCC" FontSize="8" FontWeight="Bold" FontFamily="Arial"/>
                        </Border>
                    </StackPanel>
                    <Canvas x:Name="canvasYaw" Height="190" Width="220" Background="#7F20232F" HorizontalAlignment="Center" MouseRightButtonDown="CanvasYaw_MouseRightButtonDown" ToolTip="Right-click canvas to add point, right-click point to remove">
                        <TextBlock Text="MAP %" Width="60" Foreground="#7F7D7D7D" RenderTransformOrigin="0.5,0.5" Canvas.Left="-26" Canvas.Top="85" FontFamily="Arial Black" FontSize="8" Height="12">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="50% (CTR)  →  100% (FULL)" Width="150" Foreground="#7F7D7D7D" Canvas.Left="35" Canvas.Top="176" FontFamily="Arial Black" FontSize="8" Height="12" TextAlignment="Center"/>
                        <TextBlock x:Name="textYawPointPos" Width="90" Height="36" Foreground="White" Canvas.Left="5" Canvas.Top="5" FontSize="9" FontFamily="Arial" Visibility="Hidden"/>
                        <Polygon x:Name="polygonYawBackground" Height="190" Width="220" Opacity="0.15" StrokeThickness="2">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>
                        <Polyline x:Name="polylineYawCurve" Stroke="{DynamicResource AccentColorBrush}" Height="190" Width="220" Opacity="0.85" StrokeThickness="1.5"/>
                        <Ellipse x:Name="rectStateYaw" Width="12" Height="12" Canvas.Left="0" Canvas.Top="184" Opacity="0.75" Fill="#CCEF0707">
                            <Ellipse.Effect>
                                <BlurEffect KernelType="Gaussian" RenderingBias="Quality" Radius="5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="textStateYaw" Width="45" Height="10" Foreground="#7FFFFFFF" Text="50%" FontSize="8" FontFamily="Arial"/>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <styles:SHButtonPrimary x:Name="btn_yaw_linear" Click="btn_yaw_linear_Click" Width="44" Content="Linear" Height="16" Margin="0,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_yaw_scurve" Click="btn_yaw_scurve_Click" Width="52" Content="S-Curve" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_yaw_expo" Click="btn_yaw_expo_Click" Width="44" Content="Expo" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_yaw_log" Click="btn_yaw_log_Click" Width="44" Content="Log" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- COLUMN SEPARATOR -->
                <Rectangle Grid.Column="1" Width="1" Fill="#26FFFFFF" VerticalAlignment="Stretch" Margin="5,10"/>

                <!-- RIGHT COLUMN: TOE BRAKE JOYSTICK MAPPING (0% - 100% Unipolar) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Width="264" Margin="0,0,0,0">
                    <StackPanel Height="20" Orientation="Horizontal" HorizontalAlignment="Left" Margin="22,2,0,2">
                        <Label Content="TOE BRAKE MAPPING (0% - 100%)" Foreground="White" FontFamily="Arial Black" FontSize="10" Padding="0" VerticalAlignment="Center"/>
                        <Border Background="#33FFCC00" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="UNIPOLAR" Foreground="#FFCC00" FontSize="8" FontWeight="Bold" FontFamily="Arial"/>
                        </Border>
                    </StackPanel>
                    <Canvas x:Name="canvasToe" Height="190" Width="220" Background="#7F20232F" HorizontalAlignment="Center" MouseRightButtonDown="CanvasToe_MouseRightButtonDown" ToolTip="Right-click canvas to add point, right-click point to remove">
                        <TextBlock Text="MAP %" Width="60" Foreground="#7F7D7D7D" RenderTransformOrigin="0.5,0.5" Canvas.Left="-26" Canvas.Top="85" FontFamily="Arial Black" FontSize="8" Height="12">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="0% (RELEASE)  →  100% (FULL)" Width="150" Foreground="#7F7D7D7D" Canvas.Left="35" Canvas.Top="176" FontFamily="Arial Black" FontSize="8" Height="12" TextAlignment="Center"/>
                        <TextBlock x:Name="textToePointPos" Width="90" Height="36" Foreground="White" Canvas.Left="5" Canvas.Top="5" FontSize="9" FontFamily="Arial" Visibility="Hidden"/>
                        <Polygon x:Name="polygonToeBackground" Height="190" Width="220" Opacity="0.15" StrokeThickness="2">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>
                        <Polyline x:Name="polylineToeCurve" Stroke="{DynamicResource AccentColorBrush}" Height="190" Width="220" Opacity="0.85" StrokeThickness="1.5"/>
                        <Ellipse x:Name="rectStateToe" Width="12" Height="12" Canvas.Left="0" Canvas.Top="184" Opacity="0.75" Fill="#CCEF0707">
                            <Ellipse.Effect>
                                <BlurEffect KernelType="Gaussian" RenderingBias="Quality" Radius="5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="textStateToe" Width="45" Height="10" Foreground="#7FFFFFFF" Text="0%" FontSize="8" FontFamily="Arial"/>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <styles:SHButtonPrimary x:Name="btn_toe_linear" Click="btn_toe_linear_Click" Width="44" Content="Linear" Height="16" Margin="0,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_toe_scurve" Click="btn_toe_scurve_Click" Width="52" Content="S-Curve" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_toe_expo" Click="btn_toe_expo_Click" Width="44" Content="Expo" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                        <styles:SHButtonPrimary x:Name="btn_toe_log" Click="btn_toe_log_Click" Width="44" Content="Log" Height="16" Margin="3,0,0,0" Padding="0" FontFamily="Arial" FontSize="9" MinHeight="16" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
