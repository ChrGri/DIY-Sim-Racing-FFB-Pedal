<Window x:Class="DiyFfbPedal.UIFunction.LivePlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
        mc:Ignorable="d"
        Title="DIY FFB Pedal - Live Telemetry Plotter"
        Width="980" Height="740" MinWidth="760" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="border_window_root" Background="#E6161616" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Semi-Transparent HUD Title Bar -->
            <Border Grid.Row="0" x:Name="border_title_bar" Background="#262626" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="DIY FFB Pedal — Live Telemetry Plotter" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#ECECEC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Opacity Slider & Topmost Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Opacity Slider -->
                        <TextBlock Text="🔆 Opacity:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="slider_opacity" Minimum="0.15" Maximum="1.0" Value="0.90" SmallChange="0.05" LargeChange="0.1" Width="100" Height="18" VerticalAlignment="Center" ValueChanged="SliderOpacity_ValueChanged"/>
                        <TextBlock x:Name="tb_opacity_val" Text="90%" Width="34" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,12,0"/>

                        <!-- Topmost Toggle Button -->
                        <Button x:Name="btn_topmost" Content="📌 On Top" ToolTip="Keep Live Plot Window on top of games and other windows" Click="BtnTopmost_Click" Height="22" Width="72" Style="{StaticResource ModernPillButton}"/>
                    </StackPanel>

                    <!-- Window Control Buttons (Min, Max/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btn_minimize" Content="─" ToolTip="Minimize" Click="BtnMinimize_Click" Width="28" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,4,0"/>
                        <Button x:Name="btn_maximize" Content="□" ToolTip="Maximize / Restore" Click="BtnMaximize_Click" Width="28" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,4,0"/>
                        <Button x:Name="btn_close" Content="✕" ToolTip="Close" Click="BtnClose_Click" Width="28" Height="22" Style="{StaticResource ModernPillButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Plot Control Content Area -->
            <Grid Grid.Row="1" Margin="8,4,8,8">
                <local:LivePlot_ExtendedState x:Name="LivePlotControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>
