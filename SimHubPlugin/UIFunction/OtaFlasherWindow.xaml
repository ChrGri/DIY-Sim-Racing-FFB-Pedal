<Window x:Class="DiyFfbPedal.UIFunction.OtaFlasherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WLAN OTA Firmware Flasher" Height="480" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FF252525" Foreground="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Hostname -->
            <RowDefinition Height="Auto"/>
            <!-- Firmware Selection -->
            <RowDefinition Height="Auto"/>
            <!-- Custom File path -->
            <RowDefinition Height="Auto"/>
            <!-- Flash Button -->
            <RowDefinition Height="*"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- 1. Hostname / IP Adresse -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ESP32 Hostname oder IP-Adresse:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FFCCCCCC"/>
            <TextBox x:Name="TxtHostname" Text="pedal_ota.local" Height="28" VerticalContentAlignment="Center" Padding="5,0" Background="#FF333333" Foreground="White" BorderBrush="#FF555555"/>
            <TextBlock Text="Standard: pedal_ota.local (Alternativ die IP eingeben, z.B. 192.168.178.50)" FontSize="10" Foreground="#FF888888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. Firmware Dropdown -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Firmware Version:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FFCCCCCC"/>
            <!-- DisplayMemberPath und SelectedValuePath greifen auf das Dictionary im C# Code zu -->
            <ComboBox x:Name="CboFirmware" Height="28" SelectionChanged="CboFirmware_SelectionChanged" DisplayMemberPath="Key" SelectedValuePath="Value" Background="#FF333333" Foreground="Black" />
        </StackPanel>

        <!-- 3. Custom File Panel (standardmäßig ausgeblendet) -->
        <StackPanel x:Name="PnlCustomFile" Grid.Row="2" Margin="0,0,0,15" Visibility="Collapsed">
            <TextBlock Text="Lokale firmware.bin auswählen:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FFCCCCCC"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtBinPath" Grid.Column="0" Height="28" Margin="0,0,5,0" IsReadOnly="True" VerticalContentAlignment="Center" Background="#FF333333" Foreground="White" BorderBrush="#FF555555"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Durchsuchen..." Width="100" Height="28" Click="BtnBrowse_Click" Background="#FF444444" Foreground="White" BorderBrush="#FF555555"/>
            </Grid>
        </StackPanel>

        <!-- 4. Flash Button -->
        <Button x:Name="BtnFlash" Grid.Row="3" Content="🚀 WLAN OTA Update Starten" Height="45" FontSize="14" FontWeight="Bold" Click="BtnFlash_Click" Margin="0,5,0,15" Background="#FF007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>

        <!-- 5. Log Output Area -->
        <Border Grid.Row="4" BorderBrush="#FF555555" BorderThickness="1" Background="#FF1E1E1E" CornerRadius="3">
            <Grid>
                <TextBlock Text="Flash Log:" Foreground="#FF888888" Margin="5,2,0,0" FontSize="10" VerticalAlignment="Top"/>
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#FF4CAF50" FontFamily="Consolas" BorderThickness="0" Margin="5,15,5,5"/>
            </Grid>
        </Border>
    </Grid>
</Window>