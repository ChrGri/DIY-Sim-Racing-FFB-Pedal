<UserControl x:Class="DiyFfbPedal.UIFunction.GeneralSetting_Servo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localUI="clr-namespace:DiyFfbPedal.UIElement"
             xmlns:localFunction="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="648"
             d:DataContext="{d:DesignInstance Type=localFunction:GeneralSetting_Servo}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ─── Servo Settings (sliders) ─────────────────────────────── -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,6" Padding="0,0,0,0">
                <StackPanel Width="648">
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextServoSettingTittle, 'Servo Settings'}"
                           Height="20" Padding="15,0,0,0"
                           VerticalContentAlignment="Center"
                           FontFamily="Arial Black"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Width="510" HorizontalAlignment="Center">
                        <localUI:SliderWithLabel
                            x:Name="Slider_ServoEndstopDetecionThreshold"
                            SliderLength="250"
                            SliderName="{SLoc DIYFFBPedalPlugin_TextServoSettingSliderEndstopCurrent, 'Homing endstop threshold'}"
                            Width="250" Height="40"
                            SliderValue="30" MinValue="10" MaxValue="50"
                            TickFrequency="1" Unit="%"
                            Margin="0,0,0,0"
                            SliderValueChanged="Slider_ServoEndstopDetecionThreshold_SliderValueChanged"
                            ToolTip="Increase if homing does not reach full travel. Takes effect after config reset and pedal restart."/>
                        <localUI:SliderWithLabel
                            x:Name="Slider_ServoTimeout"
                            SliderLength="250"
                            SliderName="{SLoc DIYFFBPedalPlugin_TextGeneralSettingServoIdleTimeout, 'Servo Idle Timeout'}"
                            Width="250" Height="40"
                            MaxValue="50" TickFrequency="1" Unit="mins"
                            Margin="5,0,0,0"
                            SliderValueChanged="Slider_ServoTimeoutValueChanged"
                            ToolTip="Only works with PCBA v2. Set to 0 to disable."/>
                    </StackPanel>
            <Label Content="{SLoc DIYFFBPedalPlugin_TextServoRegistersTitle, 'Servo Registers'}" Height="20" Padding="0,0,0,4" VerticalContentAlignment="Center" FontFamily="Arial Black" Foreground="White" FontSize="12" HorizontalAlignment="Left" Margin="15,0,0,0"/>
            <StackPanel Width="510">

                        <StackPanel Orientation="Horizontal">
                            <styles:SHButtonPrimary x:Name="Btn_OpenServoRegisterWindow"
                                Content="Open Servo Register Editor"
                                Width="220" Height="30"
                                HorizontalAlignment="Left"
                                Click="Btn_OpenServoRegisterWindow_Click"
                                ToolTip="Opens the independent Servo Register Editor window" Margin="0,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
</UserControl>
