<UserControl x:Class="DiyFfbPedal.UIFunction.EffectsTab_WheelSlip"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
            xmlns:localUI="clr-namespace:DiyFfbPedal.UIElement"
            xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" mc:Ignorable="d" 
            xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
            d:DesignHeight="240" d:DesignWidth="648">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource Card}" Margin="0" Padding="0,0,0,6" Height="240" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Left" Height="240" VerticalAlignment="Top" Width="648" Margin="0,0,0,0">
                <StackPanel Height="20" Width="648" Orientation="Horizontal">
                    <styles:SHToggleButton x:Name="checkbox_enable_wheelslip" Content="" Checked="checkbox_enable_wheelslip_Checked" Unchecked="checkbox_enable_wheelslip_Unchecked" IsChecked="False" FontSize="10" Width="35" Height="15" HorizontalAlignment="Left" FontFamily="Arial"  Margin="15,0,0,0" ToolTip="The effect trigger was save in local, no need send config to Pedal"/>
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextEffectWheelSlipTittle, 'Wheel Slip Notification'}" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial Black" Width="200" Height="15" HorizontalAlignment="Left" Margin="4,0,0,0"/>


                </StackPanel>
                <Canvas x:Name="canvas_plot_WS" Height="50" Width="480" Background="#141414" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Margin="15,2,0,0" >
                    <Polyline x:Name="Polyline_plot_WS" Height="50" Width="480" Points="0,25 80,25 160,25 240,25 320,25 400,25" Stroke="{DynamicResource AccentColorBrush}" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="2" />

                </Canvas>
                <StackPanel  Height="30" Width="648" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Label Content="{SLoc DIYFFBPedalPlugin_TextEffectWheelSlipProperty, 'Effect Property'}" Height="20" Width="65" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" HorizontalAlignment="Left" FontSize="10" Margin="15,0,0,0"/>
                    <TextBox x:Name="textBox_wheelslip_effect_string" Width="270" Height="20"  Margin="2,0,0,0" HorizontalAlignment="Left" MinHeight="20" FontSize="8" ToolTip="Binding shakeit Plugin property here" BorderThickness="0,0,0,0"/>
                    <Button Style="{StaticResource ModernPillButton}" x:Name="Bind_WSeffect" Click="Bind_WSeffect_Click" Width="30" Content="{SLoc DIYFFBPedalPlugin_TextBtnBind, 'Bind'}" Height="20" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                    <Button Style="{StaticResource ModernPillButton}" x:Name="Clear_WSeffect" Click="Clear_WSeffect_Click" Width="30" Content="{SLoc DIYFFBPedalPlugin_TextBtnClear, 'Clear'}" Height="20" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="10" MinHeight="20" />
                </StackPanel>



                <localUI:SliderWithLabel x:Name="Slider_WS_trigger" Width="480" Height="40" SliderLength="480" Unit=" " SliderName="{SLoc DIYFFBPedalPlugin_TextEffectWheelSlipTrigger, 'Notification Trigger'}" SliderValueChanged="Slider_WS_trigger_SliderValueChanged" SliderValue="80"/>
                <localUI:SliderWithLabel x:Name="Slider_WS_AMP" Width="480" Height="40" TickFrequency="0.1" MaxValue="20" SliderLength="480" Unit="% of Force Range" SliderName="{SLoc DIYFFBPedalPlugin_TextEffectWheelSlipAmp, 'Notification Amplitude'}" SliderValueChanged="Slider_WS_AMP_SliderValueChanged"/>
                <localUI:SliderWithLabel x:Name="Slider_WS_freq" Width="480" Height="40" SliderValue="10" Unit="Hz" SliderLength="480" MinValue="10" MaxValue="50" SliderValueChanged="Slider_WS_freq_SliderValueChanged" SliderName="{SLoc DIYFFBPedalPlugin_TextEffectWheelSlipFreq, 'Notification Frequency'}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
